<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://soap.hotel.com/payment"
           xmlns:tns="http://soap.hotel.com/payment"
           elementFormDefault="qualified">

    <xs:element name="processPaymentAndGenerateReceiptRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="reservationId" type="xs:string"/>
                <xs:element name="amount" type="xs:decimal"/>
                <xs:element name="currency" type="xs:string"/>
                <xs:element name="cardToken" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="processPaymentAndGenerateReceiptResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="transactionId" type="xs:string"/>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="authorizationCode" type="xs:string" minOccurs="0"/>
                <xs:element name="receiptXmlData" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
